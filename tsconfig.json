{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noImplicitAny": false,  // Allows implicit "any" type
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "react": [
        "./node_modules/react"
      ],
      "react-dom": [
        "./node_modules/react-dom"
      ],
      "tslib": [
        "./node_modules/tslib"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx"
  ]
}
