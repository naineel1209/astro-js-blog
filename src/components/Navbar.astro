---
// Importing the React component and logo
import NavigationMenuHelper from ".//react//NavigationMenuHelper";
import NavtxtLogo from "./subcomponents/navbar/navtxt-logo.astro";

const navListItems = [
  {
    id: 0,
    name: "Home",
    url: "/",
  },
  {
    id: 1,
    name: "About Me",
    url: "/about-me",
  },
  {
    id: 2,
    name: "Articles",
    url: "/articles",
  },
  {
    id: 3,
    name: "Code Snippets",
    url: "/code-snippets",
  },
  {
    id: 4,
    name: "ModeToggle",
    url: "/mode-toggle",
    isModeToggle: true,
  },
];
---

<nav
  class="w-full flex items-center justify-center p-4 bg-white dark:bg-black shadow-md dark:shadow-none"
>
  <NavtxtLogo />
  <NavigationMenuHelper navItems={navListItems} client:idle />
</nav>
