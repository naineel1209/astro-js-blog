---
import { Image } from "astro:assets";
import type { TArticles } from "../../../types/types";
import Tags from "../../utils/Tags.astro";

const article: TArticles = Astro.props.article;

if (!article) {
  throw new Error("Article data is missing");
}

const {
  slug: { current: articleSlug },
} = article;
---

<div
  class="flex flex-row items-stretch mb-8 w-full border-4 border-gray-300 dark:border-gray-700 shadow-lg transition-transform transform hover:scale-[101%] duration-300 rounded-lg overflow-hidden bg-gradient-to-r from-gray-100 to-gray-200 dark:from-gray-800 dark:to-gray-900"
>
  <div class="flex-shrink-0 w-1/3 p-2">
    <img
      src={article.imageUrl as string}
      alt={article.title}
      class="w-full h-full object-cover object-center rounded-md"
    />
  </div>
  <div class="w-2/3 flex flex-col p-5">
    <div class="flex justify-between items-center mb-4">
      <p class="text-sm text-gray-700 dark:text-gray-300 font-mono">{article.date}</p>
      <div class="text-yellow-500 flex items-center gap-2">
        <i class="bx bx-show"></i>
        <p>{article.views} views</p>
      </div>
    </div>
    <div class="flex-1 flex flex-col justify-center">
      <a
        href={`/articles/${articleSlug}`}
        class="text-2xl font-bold text-gray-900 dark:text-gray-200 mb-2 hover:text-gray-700 dark:hover:text-gray-400 transition-colors duration-200"
        >{article.title}</a
      >
      <p class="text-lg text-gray-700 dark:text-gray-300 mb-4">{article.description}</p>
      <a href={`/about-me`} class="">
        <span
          class="text-lg font-bold text-gray-600 dark:text-gray-400 my-2 hover:bg-gray-300 dark:hover:bg-gray-700 hover:text-gray-900 dark:hover:text-gray-200 transition-all duration-200 p-2 hover:rounded-md"
        >
          {article.author.name}
        </span>
      </a>
      <Tags
        tags={article.tags}
        class:list={["my-2 p-2 border-t-2 border-gray-300 dark:border-gray-600"]}
        starred={article.starred}
      />
    </div>
    <a
      href={`/articles/${articleSlug}`}
      class="mt-auto p-3 bg-gray-700 dark:bg-gray-600 text-white dark:text-gray-200 font-bold flex items-center justify-center rounded-md hover:bg-gray-600 dark:hover:bg-gray-500 transition-colors duration-300"
    >
      Read More
    </a>
  </div>
</div>
