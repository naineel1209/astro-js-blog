---
const { title } = Astro.props;
---

<h1 class="title">
  {title}
</h1>

<style>
  .title {
    @apply relative inline-block text-[2rem] font-bold mb-4;
  }

  .title::after {
    content: '';
    @apply absolute left-0 bottom-2 h-3 w-0 z-[-1] transition-all duration-300 ease-in-out;
  }

  .title:hover::after {
    @apply w-full;
  }

  /* Light mode styles */
  :root .title::after {
    @apply bg-blue-200;
  }

  /* Dark mode styles */
  :root.dark .title::after {
    @apply bg-blue-800;
  }
</style>
