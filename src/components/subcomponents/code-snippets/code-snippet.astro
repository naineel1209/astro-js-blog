---
import { getSanityCodeSnippets } from "../../../data/code-snippets";
import Prism from "prismjs";
import "prismjs/themes/prism-okaidia.css";
import loadLanguages from "prismjs/components/index";
import { TCodeSnippet } from "../../../types/types";

let codeSnippets: TCodeSnippet[] = [];
try {
  codeSnippets = await getSanityCodeSnippets();
} catch (error) {
  console.error("Error fetching code snippets:", error);
}
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  {
    codeSnippets.length > 0 ? (
      codeSnippets.map((snippet) => {
        const lang = snippet.code.language;

        try {
          loadLanguages([lang]);
        } catch (e) {
          console.warn(`Language "${lang}" is not supported by Prism.js.`, e);
        }

        const highlighted = Prism.languages[lang]
          ? Prism.highlight(snippet.code.code, Prism.languages[lang], lang)
          : snippet.code.code; // Fallback: Show raw code if the language isn't supported

        return (
          <div class="bg-white dark:bg-gray-800  bg-gradient-to-r from-gray-100 to-gray-200 dark:from-gray-800 dark:to-gray-900 border-2 border-gray-300 dark:border-gray-700 shadow-md rounded-lg p-4">
            <div class="p-2">
              <h2 class="text-xl font-bold text-stone-950 dark:text-gray-100">{snippet.title}</h2>
              <p class="text-gray-600 dark:text-gray-300">{snippet.description}</p>
            </div>
            <div class="flex items-center justify-between font-bold text-stone-950 dark:text-gray-100 p-2">
              <span>{snippet.code.language}</span>
              <span>{snippet.code.filename}</span>
            </div>
            <pre class="p-4 rounded-lg mt-4 bg-gray-800 dark:bg-gray-900 h-[500px] overflow-scroll">
              <code class={`language-${lang}`} set:html={highlighted.trim()} />
            </pre>
          </div>
        );
      })
    ) : (
      <p class="text-center text-gray-500 col-span-full dark:text-gray-400">
        No code snippets available at the moment.
      </p>
    )
  }
</div>
