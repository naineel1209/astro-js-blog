---
const { title } = Astro.props;
---

<h1 class="title">
  {title}
</h1>

<style>
  .title {
    position: relative;
    display: inline-block;
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 1rem;
  }

  .title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.5rem;
    height: 0.75rem;
    width: 0;
    background-color: rgb(219 234 254);
    z-index: -1;
    transition: width 0.3s ease;
  }

  .title:hover::after {
    width: 100%;
  }
</style>