---
const { prefillVal } = Astro.props;
---

<script>
  const searchBarForm = document.getElementById(
    "search-bar-form"
  ) as HTMLFormElement;

  searchBarForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const searchQuery = new FormData(searchBarForm).get("search-query");

    if (searchQuery) {
      window.location.href = `/articles/search/${searchQuery}`;
    } else {
      window.location.href = `/articles`;
    }
  });
</script>

<form id="search-bar-form" class="w-[100%] flex">
  <input
    type="text"
    value={prefillVal}
    name="search-query"
    placeholder="Search articles"
    class="border-2 border-gray-900 bg-white text-gray-900 p-2 rounded-md w-[50%] border-r-0 rounded-r-none focus:ring-2 focus:ring-gray-900 transition-all duration-300"
  />
  <button
    type="submit"
    class="border-2 border-gray-900 border-l-0 rounded-l-none bg-gray-700 dark:bg-gray-800 text-white p-2 rounded-md w-[10%] hover:bg-gray-800 hover:border-gray-800 transition-all duration-300"
  >
    Search
  </button>
</form>
